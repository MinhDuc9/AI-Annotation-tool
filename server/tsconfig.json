{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2023",
        "sourceMap": true,
        "outDir": "./dist",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,
        "strictBindCallApply": false,
        "noFallthroughCasesInSwitch": false,
        "typeRoots": [
            "./src/types", // your declaration folder
            "./node_modules/@types" // default types
        ],
        "types": ["node"]
    },
    "include": [
        "src/**/*.ts", // your source files
        "src/types/**/*.d.ts" // your new global types
    ]
}
