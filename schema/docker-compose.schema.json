{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Docker Compose schema",
  "description": "Minimal schema so editors do not need to download the Compose spec.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "networks": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
  "additionalProperties": true
}
